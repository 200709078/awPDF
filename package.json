{
  "name": "awpdf",
  "productName": "awPDF",
  "desktopName": "awpdf",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "description": "awPDF — PDF görüntüleme uygulaması",
  "author": "mADEMatik <ademvarol@madematik.com>",
  "license": "MIT",
  "homepage": "https://www.madematik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/200709078/awPDF.git"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "deploy": "npm run build && node scripts/deploy-ftp.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && node scripts/dev-electron.mjs",
    "electron": "npm run build && node scripts/start-electron.mjs",
    "test": "playwright test",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "build": {
    "appId": "com.madematik.awpdf",
    "productName": "awPDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "awPDF.Document",
        "description": "PDF belgesi",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office;Viewer;Education",
      "executableName": "awpdf",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "awPDF",
          "Comment": "PDF görüntüleme"
        }
      }
    },
    "deb": {
      "packageCategory": "education"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "awPDF"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@tesseract.js-data/tur": "1.0.0",
    "docx": "9.13.0",
    "docx-preview": "0.4.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "basic-ftp": "^6.2.3",
    "dotenv": "^17.4.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
